                        <h4>希望待遇</h4>
                        <p>月薪 60,000 元以上</p>
                    </div>
                    <div class="preference-item">
                        <h4>可上班日</h4>
                        <p>錄取後兩週可上班</p>
                    </div>
                    <div class="preference-item">
                        <h4>希望產業</h4>
                        <p>軟體及網路相關業、醫療服務業</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 頁尾 -->
